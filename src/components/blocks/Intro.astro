<script is:inline>
	if (sessionStorage.getItem("hasSeenIntro") === "true") {
		document.getElementById("intro")?.classList.add("intro--quick-fade");
	}
</script>

<style>
	.intro {
		display: grid;
		z-index: 100000;
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100vh;
		height: 100dvh;
		background: var(--color-bg-main, #ffffff);
		place-items: center;
		padding: var(--space-main, 2rem);
		will-change: clip-path;
		clip-path: polygon(
			0% 0%,
			100% 0%,
			100% 100%,
			85% 100%,
			70% 100%,
			50% 100%,
			30% 100%,
			15% 100%,
			0% 100%
		);

		&.intro--quick-fade {
			pointer-events: none;
			animation: quickFadeOut 0.25s ease-out forwards;
			& > .intro_signature {
				display: none;
			}
		}

		&.intro--out {
			pointer-events: none;
			animation: curtainBendyPolygon 1.05s cubic-bezier(0.76, 0, 0.24, 1) forwards;

			& > .intro_signature {
				transform: translateY(-14vh) scale(0.92);
				opacity: 0;
			}
		}
	}

	.intro_signature {
		width: min(100%, 100ch);
		transition:
			transform 0.9s cubic-bezier(0.7, 0, 0.2, 1),
			opacity 0.65s ease-in;
		will-change: transform, opacity;
	}

	.intro_signature_sign {
		fill: none;
		stroke: var(--color-brand-main, #6667ab);
		stroke-linejoin: miter;
		stroke-miterlimit: 4;
		stroke-width: 0.75px;
	}

	@media (prefers-color-scheme: dark) {
		.intro_signature_sign {
			stroke: var(--color-brand-xs, #ccccff);
		}
	}

	@keyframes curtainBendyPolygon {
		0% {
			clip-path: polygon(
				0% 0%,
				100% 0%,
				100% 100%,
				85% 100%,
				70% 100%,
				50% 100%,
				30% 100%,
				15% 100%,
				0% 100%
			);
		}
		45% {
			clip-path: polygon(
				0% 0%,
				100% 0%,
				100% 68%,
				85% 51%,
				70% 39%,
				50% 32%,
				30% 39%,
				15% 51%,
				0% 68%
			);
		}
		75% {
			clip-path: polygon(
				0% 0%,
				100% 0%,
				100% 28%,
				85% 17%,
				70% 10%,
				50% 6%,
				30% 10%,
				15% 17%,
				0% 28%
			);
		}
		100% {
			clip-path: polygon(
				0% 0%,
				100% 0%,
				100% 0%,
				85% 0%,
				70% 0%,
				50% 0%,
				30% 0%,
				15% 0%,
				0% 0%
			);
		}
	}

	@keyframes quickFadeOut {
		to {
			opacity: 0;
			visibility: hidden;
		}
	}
</style>

<script>
	const intro = document.getElementById("intro");
	const firstAnim = document.getElementById("introsign1_a") as SVGAnimateElement | null;
	const lastAnim = document.getElementById("introsign5_a") as SVGAnimateElement | null;

	if (intro) {
		const removeIntroOnAnimationEnd = (e: AnimationEvent) => {
			if (e.target === intro) {
				intro.removeEventListener("animationend", removeIntroOnAnimationEnd);
				intro.remove();
			}
		};

		if (intro.classList.contains("intro--quick-fade")) {
			intro.addEventListener("animationend", removeIntroOnAnimationEnd);
		} else {
			sessionStorage.setItem("hasSeenIntro", "true");

			const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			if (prefersReducedMotion) {
				intro.classList.add("intro--quick-fade");
				intro.addEventListener("animationend", removeIntroOnAnimationEnd);
			} else if (firstAnim && lastAnim) {
				setTimeout(() => firstAnim.beginElement(), 200);

				lastAnim.addEventListener(
					"endEvent",
					() => {
						setTimeout(() => {
							intro.classList.add("intro--out");
							intro.addEventListener("animationend", removeIntroOnAnimationEnd);
						}, 600);
					},
					{ once: true }
				);
			}
		}
	}
</script>