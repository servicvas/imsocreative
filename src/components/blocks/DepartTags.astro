<style>
	@keyframes fly-depart {
		0% {
			transform: translateZ(-1000px);
			opacity: 0;
			filter: blur(5px);
		}
		50% {
			transform: translateZ(0px);
			opacity: 1;
			filter: blur(0px);
		}
		100% {
			transform: translateZ(1000px);
			opacity: 0;
			filter: blur(5px);
		}
	}

	.depart_section {
		position: absolute;
		inset-inline: 0;
		top: -10rem;
		height: 80rem;
		perspective: 80rem;
		display: grid;
		grid: repeat(4, 25vh) / repeat(4, 25vw);
		place-items: center;
		overflow: clip;
		pointer-events: none;
	}

	@media (width >= 1200px) {
		.depart_section {
			top: 14rem;
			height: 160vh;
			perspective: 50rem;
		}
	}

	.depart_section > .depart_tag {
		font-family: var(--font-family-secondary);
		font-size: var(--font-size-l);
		color: var(--color-brand-s);
	}

	.depart_section > .depart_tag:nth-of-type(1)  { grid-area: 1 / 1; }
	.depart_section > .depart_tag:nth-of-type(2)  { grid-area: 1 / 2; }
	.depart_section > .depart_tag:nth-of-type(3)  { grid-area: 1 / 3; }
	.depart_section > .depart_tag:nth-of-type(4)  { grid-area: 1 / 4; }
	.depart_section > .depart_tag:nth-of-type(5)  { grid-area: 2 / 1; }
	.depart_section > .depart_tag:nth-of-type(6)  { grid-area: 2 / 2; }
	.depart_section > .depart_tag:nth-of-type(7)  { grid-area: 2 / 3; }
	.depart_section > .depart_tag:nth-of-type(8)  { grid-area: 2 / 4; }
	.depart_section > .depart_tag:nth-of-type(9)  { grid-area: 3 / 1; }
	.depart_section > .depart_tag:nth-of-type(10) { grid-area: 3 / 2; }
	.depart_section > .depart_tag:nth-of-type(11) { grid-area: 3 / 3; }
	.depart_section > .depart_tag:nth-of-type(12) { grid-area: 3 / 4; }
	.depart_section > .depart_tag:nth-of-type(13) { grid-area: 4 / 1; }
	.depart_section > .depart_tag:nth-of-type(14) { grid-area: 4 / 2; }
	.depart_section > .depart_tag:nth-of-type(15) { grid-area: 4 / 3; }
	.depart_section > .depart_tag:nth-of-type(16) { grid-area: 4 / 4; }
	.depart_section > .depart_tag:nth-of-type(17) { grid-area: 2 / 1; }
	.depart_section > .depart_tag:nth-of-type(18) { grid-area: 2 / 2; }
	.depart_section > .depart_tag:nth-of-type(19) { grid-area: 2 / 3; }
	.depart_section > .depart_tag:nth-of-type(20) { grid-area: 2 / 4; }
	.depart_section > .depart_tag:nth-of-type(21) { grid-area: 3 / 1; }
	.depart_section > .depart_tag:nth-of-type(22) { grid-area: 3 / 2; }
	.depart_section > .depart_tag:nth-of-type(23) { grid-area: 3 / 3; }
	.depart_section > .depart_tag:nth-of-type(24) { grid-area: 3 / 4; }
	.depart_section > .depart_tag:nth-of-type(25) { grid-area: 1 / 1; }

	.depart_section > .depart_tag:nth-of-type(1)  { animation-range: 0% 65%; }
	.depart_section > .depart_tag:nth-of-type(2)  { animation-range: 10% 94%; }
	.depart_section > .depart_tag:nth-of-type(3)  { animation-range: 52% 82%; }
	.depart_section > .depart_tag:nth-of-type(4)  { animation-range: 50% 80%; }
	.depart_section > .depart_tag:nth-of-type(5)  { animation-range: 45% 75%; }
	.depart_section > .depart_tag:nth-of-type(6)  { animation-range: 0% 90%; }
	.depart_section > .depart_tag:nth-of-type(7)  { animation-range: 0% 100%; }
	.depart_section > .depart_tag:nth-of-type(8)  { animation-range: 0% 60%; }
	.depart_section > .depart_tag:nth-of-type(9)  { animation-range: 0% 65%; }
	.depart_section > .depart_tag:nth-of-type(10) { animation-range: 5% 64%; }
	.depart_section > .depart_tag:nth-of-type(11) { animation-range: 0% 55%; }
	.depart_section > .depart_tag:nth-of-type(12) { animation-range: 52% 82%; }
	.depart_section > .depart_tag:nth-of-type(13) { animation-range: 15% 55%; }
	.depart_section > .depart_tag:nth-of-type(14) { animation-range: 7% 57%; }
	.depart_section > .depart_tag:nth-of-type(15) { animation-range: 15% 75%; }
	.depart_section > .depart_tag:nth-of-type(16) { animation-range: 3% 63%; }
	.depart_section > .depart_tag:nth-of-type(17) { animation-range: 7% 97%; }
	.depart_section > .depart_tag:nth-of-type(18) { animation-range: 32% 82%; }
	.depart_section > .depart_tag:nth-of-type(19) { animation-range: 47% 77%; }
	.depart_section > .depart_tag:nth-of-type(20) { animation-range: 37% 67%; }
	.depart_section > .depart_tag:nth-of-type(21) { animation-range: 12% 32%; }
	.depart_section > .depart_tag:nth-of-type(22) { animation-range: 8% 44%; }
	.depart_section > .depart_tag:nth-of-type(23) { animation-range: 4% 74%; }
	.depart_section > .depart_tag:nth-of-type(24) { animation-range: 0% 64%; }
	.depart_section > .depart_tag:nth-of-type(25) { animation-range: 48% 68%; }


	@supports (animation-timeline: scroll()) {
		@media (prefers-reduced-motion: no-preference) {
			.depart_section > .depart_tag {
				opacity: 0;
				animation-name: fly-depart;
				animation-duration: auto;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: scroll(root block);
			}
		}
	}
</style>