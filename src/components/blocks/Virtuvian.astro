<style>
	.virtuvian_cover {
		width: min(100%, 60vh);
		height: auto;
		aspect-ratio: 1 / 1;
		position: relative;
		view-timeline-name: --virtuvian-scroll;
		view-timeline-axis: block;

		@media screen and (width >= 1200px) {
			width: min(100%, 80vh);
		}
		@media screen and (width >= 1600px) {
			width: min(100%, 90vh);
		}
	}

	.virtuvian_cover svg {
		overflow: visible;
	}

	.virtuvian_cover--img,
	.virtuvian_bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.virtuvian_cover--img {
		transform-origin: 50% 98.9%;
		opacity: 0;
		scale: 0.94;
		filter: blur(8px);
		will-change: scale, opacity, filter;
	}

	.virtuvian_bg * {
		stroke: var(--color-brand-main);
		vector-effect: non-scaling-stroke;
		stroke-width: 1;
		stroke-miterlimit: 1;

		@media screen and (width >= 860px) and (width < 1200px) {
			stroke-width: 2;
			stroke-miterlimit: 2;
		}

		@media screen and (width >= 1200px) {
			stroke-width: 1.5;
			stroke-miterlimit: 1.5;
		}
	}

	.virtuvian_bg--round {
		transform-box: view-box;
		transform-origin: 500px 500px;
		transform: scale(0);
		opacity: 0;
		will-change: transform, opacity;
	}

	.virtuvian_bg--square {
		vector-effect: none;
		stroke-width: 2.2;
		stroke-dasharray: 3211;
		stroke-dashoffset: 3211;
		will-change: stroke-dashoffset;

		@media screen and (width >= 860px) and (width < 1200px) {
			stroke-width: 3;
		}

		@media screen and (width >= 1200px) {
			stroke-width: 2;
		}
	}

	#virtuvian_bg--controls rect {
		transform-box: fill-box;
		transform-origin: center;
		transform: scale(0);
		opacity: 0;
		will-change: transform, opacity;
	}

	:global(.hero.is-ready) {
		& .virtuvian_bg--round {
			animation: expand-round 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;
		}

		& .virtuvian_cover--img {
			animation: reveal-image 1.15s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards;
		}

		& .virtuvian_bg--square {
			animation: draw-square 1.4s cubic-bezier(0.4, 0, 0.2, 1) 0.25s forwards;
		}

		& #virtuvian_bg--controls rect {
			animation: pop-in-control 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.35s + var(--i, 0) * 0.14s) forwards;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.virtuvian_cover--img,
		.virtuvian_bg--round,
		.virtuvian_bg--square,
		#virtuvian_bg--controls rect {
			animation: none !important;
			transform: none !important;
			scale: 1 !important;
			opacity: 1 !important;
			filter: none !important;
			stroke-dashoffset: 0 !important;
		}
	}

	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.virtuvian_bg--round-wrap,
			.virtuvian_bg--frame {
				transform-box: view-box;
				transform-origin: 500px 989.05px;
				will-change: transform, opacity;
				animation-timeline: --virtuvian-scroll;
				animation-fill-mode: both;
				animation-range: exit-crossing 0% exit 90%;
				animation-timing-function: linear;
			}

			.virtuvian_bg--round-wrap {
				animation-name: shrink-round;
			}

			.virtuvian_bg--frame {
				animation-name: shrink-frame;
			}
		}
	}

	@keyframes reveal-image {
		0% {
			opacity: 0;
			scale: 0.94;
			filter: blur(8px);
		}
		100% {
			opacity: 1;
			scale: 1;
			filter: blur(0px);
		}
	}

	@keyframes expand-round {
		0% {
			transform: scale(0);
			opacity: 0;
		}
		30% {
			opacity: 1;
		}
		100% {
			transform: scale(1);
			opacity: 1;
		}
	}

	@keyframes draw-square {
		0% {
			stroke-dashoffset: 3211;
		}
		100% {
			stroke-dashoffset: 0;
		}
	}

	@keyframes pop-in-control {
		0% {
			transform: scale(0);
			opacity: 0;
		}
		100% {
			transform: scale(1);
			opacity: 1;
		}
	}

	@keyframes shrink-round {
		0% {
			transform: scale(1);
			opacity: 1;
		}
		55% {
			transform: scale(0.32);
			opacity: 0.5;
		}
		100% {
			transform: scale(0.008);
			opacity: 0.1;
		}
	}

	@keyframes shrink-frame {
		0% {
			transform: scale(1);
			opacity: 1;
		}
		55% {
			transform: scale(0.45);
			opacity: 0.5;
		}
		100% {
			transform: scale(0.01);
			opacity: 0.1;
		}
	}
</style>